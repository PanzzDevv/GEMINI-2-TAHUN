<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Google One Pro"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Free Trial Activation"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Button 1: Setup Environment -->
    <Button
        android:id="@+id/btnSetup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_orange"
        android:text="Setup Environment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Button 2: List Offers -->
    <Button
        android:id="@+id/btnList"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_blue"
        android:text="List Offers"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Button 3: Pro 12M Step 1 -->
    <Button
        android:id="@+id/btnPro12"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_purple"
        android:text="Pro 12M • Step 1"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Button 4: Pro 3M Fallback -->
    <Button
        android:id="@+id/btnPro3"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_orange"
        android:text="Pro 3M • Fallback"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Button 5: Stack +6M Step 2 -->
    <Button
        android:id="@+id/btnStep2"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_teal"
        android:text="Stack +6M • Step 2"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Button 6: Stack +6M Step 3 -->
    <Button
        android:id="@+id/btnStep3"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_teal"
        android:text="Stack +6M • Step 3"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Action Link: Close -->
    <TextView
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Close"
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:padding="4dp" />

    <!-- Credit link -->
    <TextView
        android:id="@+id/tvCreated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Created by t.me/rccstore"
        android:textColor="#60A5FA"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <!-- Terminal Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_terminal"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/scrollTerminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Ready.\nSelect an action above to start."
                android:textColor="#93C5FD"
                android:textSize="11sp" />
        </ScrollView>

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:gravity="center"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </FrameLayout>

</LinearLayout>
